{
  "name": "dsh-tui-skill-mcp-panel",
  "version": "0.1.0-dev.0",
  "description": "Visual skill & MCP manager for dsh-TUI: full-screen scene behind /skill-mcp.",
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/domain/*.test.js",
    "test:ui": "pnpm build && node scripts/ui-render-smoke.mjs",
    "test:ui:interaction": "pnpm build && node scripts/ui-interaction-smoke.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "get-east-asian-width": "^1.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || 4.0.5-alpha.2",
    "@deepseek-harness-tui/dsh-tui": ">=0.19.0 <0.20.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-harness-tui/dsh-tui": "0.19.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@xterm/headless": "^6.0.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuqiuwangtian/dsh-tui-skill-mcp-panel.git"
  },
  "homepage": "https://github.com/wuqiuwangtian/dsh-tui-skill-mcp-panel#readme",
  "bugs": {
    "url": "https://github.com/wuqiuwangtian/dsh-tui-skill-mcp-panel/issues"
  }
}
